# Example non-secret config. Copy to /etc/private-ballot-hosted/hosted.env (root-owned, 0600).
PRIVATE_BALLOT_HOSTED_BIND=127.0.0.1:8788
PRIVATE_BALLOT_HOSTED_SERVICE=hosted
PRIVATE_BALLOT_HOSTED_API_VERSION=v1
PRIVATE_BALLOT_HOSTED_DB=/var/lib/private-ballot-hosted/hosted.db
PRIVATE_BALLOT_HOSTED_RATE_LIMIT_PER_MIN=120
# Set a strong random token for localhost admin routes (import/close/finalize).
# NEVER expose /api/v1/admin/* through Cloudflare in Stage 3 without blocking it at the edge.
PRIVATE_BALLOT_HOSTED_ADMIN_TOKEN=change-me-to-a-random-secret
# Do NOT set PRIVATE_BALLOT_HOSTED_ALLOW_PUBLIC_BIND=1.
