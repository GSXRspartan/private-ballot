# Example non-secret config. Copy to /etc/private-ballot-hosted/hosted.env
# (root-owned, 0600, owned by the service account or root). NEVER in Git.
#
# Public plane — the ONLY listener Cloudflare Tunnel may route to.
PRIVATE_BALLOT_HOSTED_BIND=127.0.0.1:8788
# Admin plane — loopback-only, always. Never routed through Cloudflare.
# Organizer import/close/finalize are served ONLY here (token-gated).
PRIVATE_BALLOT_HOSTED_ADMIN_BIND=127.0.0.1:8789
PRIVATE_BALLOT_HOSTED_SERVICE=hosted-staging
PRIVATE_BALLOT_HOSTED_API_VERSION=v1
PRIVATE_BALLOT_HOSTED_DB=/var/lib/private-ballot-hosted/hosted.sqlite3
PRIVATE_BALLOT_HOSTED_RATE_LIMIT_PER_MIN=120
# Strong random token for localhost admin routes. Keep in this file only.
PRIVATE_BALLOT_HOSTED_ADMIN_TOKEN=change-me-to-a-random-secret
# Origin token enforced on the public plane when set. The Cloudflare Worker
# injects it as `x-private-ballot-origin` (wrangler secret ORIGIN_TOKEN);
# the browser never knows it. Must match the Worker secret. /health is
# exempt so Tunnel health checks work.
PRIVATE_BALLOT_HOSTED_ORIGIN_TOKEN=change-me-to-a-random-secret
# Do NOT set PRIVATE_BALLOT_HOSTED_ALLOW_PUBLIC_BIND=1 in staging.
